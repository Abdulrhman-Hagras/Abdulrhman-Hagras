{% comment %}
  Custom Banner Section - Pixel Perfect with the figma design
{% endcomment %}
<section class="custom-banner-section">
  <header class="banner-top-bar">
    <div class="hamburger-menu">
      <img
        src="{{ 'menu_bar.svg'| asset_url}}"
        alt=""
        class="menu-icon"
        width="20"
        height="13"
      >
    </div>
    <div class="brand-logo">
      <img
        src="{{ 'logo.svg'| asset_url}}"
        alt=""
        class="logo-icon"
        width="153"
        height="20"
      >
    </div>
    <div class="tagline">
      <p>
        {{ section.settings.tagline_text }}
      </p>
    </div>
    <a
      href="{{ section.settings.choose_gift_link }}"
      class="btn btn-animated choose-gift"
    >
      <p>choose gift</p>
      <img
        src="{{ 'arrow.svg'| asset_url}}"
        alt=""
        class="menu-icon"
        width="26"
        height="12"
      >
    </a>
  </header>
  <div class="banner-content">
    <div class="banner-illustration">
      <img
        src="{{ 'Frame_1.svg'| asset_url}}"
        alt=""
        class="illustration-frame-1"
        width="1440"
        height="390"
        loading="lazy"
      >
    </div>
    <div class="banner-bottom-row">
      <div class="banner-main-content">
        <h1 class="main-heading">The Gift Guide</h1>
        <p class="description">
          Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts
          to delight your loved ones this holiday season.
        </p>
        <a href="{{ section.settings.shop_now_link }}" class="btn btn-animated shop-now">
          <p>shop now</p>
          <img
            src="{{ 'arrow white.svg'| asset_url}}"
            alt=""
            class="arrow-icon"
            width="26"
            height="12"
          >
        </a>
      </div>
      <img
        src="{{ 'Frame_2.svg'| asset_url}}"
        alt=""
        class="illustration-frame-2"
        width="890"
        height="402"
        loading="lazy"
      >
    </div>
    <div class="bottom-banner">
      <p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>
    </div>
  </div>
</section>



{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_gift_text",
      "label": "Choose Gift Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "choose_gift_link",
      "label": "Choose Gift Button Link"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_now_text",
      "label": "Shop Now Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_now_link",
      "label": "Shop Now Button Link"
    },
    {
      "type": "text",
      "id": "bottom_banner_text",
      "label": "Bottom Banner Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [{ "name": "Custom Banner" }]
}
{% endschema %}

