{% comment %}
  Custom Banner Section - Pixel Perfect with the figma design
{% endcomment %}
<section class="custom-banner-section">
      <header class="banner-top-bar">
        <div class="hamburger-menu">
          <img
            src="{{'menu_bar.svg'|asset_url}}"
            alt="Hamburger Menu"
            class="menu-icon"
            width="20"
            height="13"
          />
        </div>
        <div class="brand-logo">
          <img
            src="{{'logo.svg'|asset_url}}"
            alt="Brand Logo"
            class="logo-icon"
            width="153"
            height="20"
          />
        </div>
        <div class="tagline">
          <p>Find the ideal gift for your loved ones.</p>
        </div>
        <a href="#" class="btn btn-animated choose-gift">
          <span>CHOOSE GIFT</span>
          <img
            src="{{'arrow.svg'|asset_url}}"
            alt="Arrow"
            class="arrow-icon"
            width="26"
            height="12"
          />
        </a>
      </header>
      <div class="banner-content">
        <div class="banner-illustration">
          <img
            src="{{'Frame_1.svg'|asset_url}}"
            alt="Decorative background illustration"
            class="illustration-frame-1"
            width="1440"
            height="390"
            loading="lazy"
          />
        </div>
        <div class="banner-bottom-row">
          <div class="banner-main-content">
            <h1 class="main-heading">The Gift Guide</h1>
            <p class="description">Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>
              <img
            src="{{'Frame_3.svg'|asset_url}}"
            alt="Gift illustration"
            class="banner-illustration-3"
           width="376" height="264"
            loading="lazy"
          />
            <a href="#" class="btn btn-animated shop-now">
              <span>SHOP NOW</span>
              <img
                src="{{'arrow white.svg' |asset_url}}"
                alt="Arrow"
                class="arrow-icon"
                width="26"
                height="12"
              />
            </a>
          </div>
          <img
            src="{{'Frame_2.svg'|asset_url}}"
            alt="Gift illustration"
            class="illustration-frame-2"
            width="890"
            height="402"
            loading="lazy"
          />
        </div>
        <div class="bottom-banner">
          <p>SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL</p>
        </div>
      </div>
    </section>

<style>
  /* Import Jost font */
@import url("https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap");

:root {
  --font-family: "Jost", sans-serif;
  --color-white: #f5f5f5;
  --color-yellow: #fff544;
  --color-black: #000;
  --color-background: #fff;
}

* {
  -webkit-box-sizing: border-box;
  -moz-box-sizing: border-box;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
}

html,
body {
  width: 100%;
  height: 100%;
  background: var(--color-background);
  scroll-behavior: smooth;
  font-family: var(--font-family);
}

.custom-banner-section {
  position: relative;
  background: var(--color-background);
  display: flex;
  flex-direction: column;
}

/* Top Header Bar */
.banner-top-bar {
  height: 64px;
  position: relative;
  z-index: 10;
  display: flex;
  width: 100%;
  justify-content: space-around;
  align-items: center;
  background: var(--color-white);
  padding: 10px 50px;
}

.hamburger-menu {
  flex: 0 0 auto;
  display: none; /* Hidden on desktop */
}
.banner-main-content .banner-illustration-3 {
  display: none;
}
.menu-icon {
  width: 20px;
  height: 13px;
}

.brand-logo {
  flex: 0 0 auto;
}

.logo-icon {
  width: 153px;
  height: 20px;
}

.tagline {
  font-weight: 400;
  font-size: 16px;
  line-height: 13.42px;
  letter-spacing: 0px;
  text-align: center;
  vertical-align: middle;
  color: var(--color-black);
}

/* Banner Content Area */
.banner-content {
  align-items: center;
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* Background illustration */
.banner-illustration {
  text-align: center;
  position: relative;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}



/* Main content container */
.banner-bottom-row {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-around;
 
}

/* Main Content */
.banner-main-content {
  flex: 0 0 auto;
  max-width: 483px;
}

.main-heading {
  font-size: 56px;
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 20px;
  color: var(--color-black);
  letter-spacing: 0px;
}

.description {
  font-size: 20px;
  font-weight: 400;
  line-height: 1.4;
  color: var(--color-black);
  margin-bottom: 32px;
}

/* Right illustration */
.illustration-frame-2 {
  flex: 1;
  max-width: 890px;
  height: auto;
  object-fit: contain;
}

/* Button base style */
.btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 12px 41px;
  font-weight: 400;
  font-size: 16px;
  text-decoration: none;
  text-transform: uppercase;
  border: none;
  cursor: pointer;
  transition: all 0.3s ease;
  border-radius: 0;
  overflow: hidden;
}

.btn span,
.btn .arrow-icon {
  position: relative;
  z-index: 1;
  transition: all 0.4s ease;
}

/* Choose Gift button (yellow -> black) */
.choose-gift {
  background: var(--color-yellow);
  color: var(--color-black);
}

.choose-gift::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: var(--color-black);
  transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  z-index: 0;
}

.choose-gift:hover::before {
  left: 0;
}

.choose-gift:hover {
  color: var(--color-white);
}

.choose-gift .arrow-icon {
  filter: brightness(0);
}

.choose-gift:hover .arrow-icon {
  filter: brightness(0) invert(1);
}

/* Shop Now button (black -> yellow) */
.shop-now {
  background: var(--color-black);
  color: var(--color-white);
}

.shop-now::before {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: var(--color-yellow);
  transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  z-index: 0;
}

.shop-now:hover::before {
  left: 0;
}

.shop-now:hover {
  color: var(--color-black);
}

.shop-now .arrow-icon {
  margin-left: 4px;
  filter: brightness(0) invert(1);
}

.shop-now:hover .arrow-icon {
  filter: brightness(0);
}

/* Arrow icons */
.arrow-icon {
  width: 26px;
  height: 12px;
  flex-shrink: 0;
}

/* Bottom Banner */
.bottom-banner {
  position: relative;
  z-index: 2;
  text-align: center;
  padding: 16px 40px;
  background: #f8f8f8;
  font-size: 12px;
  font-weight: 500;
  text-transform: uppercase;
  color: var(--color-black);
  width: 100%;
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .banner-top-bar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .brand-logo {
    margin: 0 auto;
  }
  
  .tagline {
    display: none;
  }
  .choose-gift {
    display: none;
  }
  .banner-illustration  {
    display: none;
  }
  .hamburger-menu {
    display: block; 
   
  }
  .banner-bottom-row {
    flex-direction: column;
    text-align: center;
    
  }

  .banner-main-content {
    position: relative;
    
  }
  .banner-main-content .description {
    margin: 0 auto;
    max-width: 70%;
    
  }
  .banner-main-content p{
   display: -webkit-box;
  -webkit-line-clamp: 2; /* number of lines */
  -webkit-box-orient: vertical;
  overflow: hidden;
  }

  .illustration-frame-1 {
    display: none;
  }
  .banner-main-content  {
    margin-top: 49px;
  }

  .illustration-frame-2 {
   display: none;
  }
  .banner-main-content .banner-illustration-3 {
  display: block;
  width: 100%;
}
  .main-heading {
    font-size: 30px;
  }

  .description {
    font-size: 16px;
  }

  .bottom-banner {
    padding: 12px 20px;
    font-size: 11px;
  }
}

@media (max-width: 480px) {
  .banner-top-bar {
    padding: 8px 15px;
  }

  .logo-icon {
    width: 120px;
    height: 16px;
  }

  .tagline {
    font-size: 12px;
  }

  .main-heading {
    font-size: 36px;
  }

  .description {
    font-size: 16px;
  }

 
}


</style>


{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "choose_gift_text",
      "label": "Choose Gift Button Text",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "choose_gift_link",
      "label": "Choose Gift Button Link"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "shop_now_text",
      "label": "Shop Now Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "shop_now_link",
      "label": "Shop Now Button Link"
    },
    {
      "type": "text",
      "id": "bottom_banner_text",
      "label": "Bottom Banner Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [{ "name": "Custom Banner" }]
}
{% endschema %}
