{% comment %}
  Custom Grid Section for Products (Assessment)
{% endcomment %}

<section class="custom-grid-section">
  <h2 class="grid-title">Tisso vision in the wild</h2>
  <div class="grid-container">
    
    {%- comment -%}
    Loop through ALL products in your store
    You can add a limit to control the number of products displayed
    {%- endcomment -%}
    {%- for product in collections.all.products limit: 6 -%}
      {%- comment -%} Ensure the product and its first variant exist {%- endcomment -%}
      {%- if product and product.selected_or_first_available_variant -%}
        {%- assign variant = product.selected_or_first_available_variant -%}
        <a 
          href="{{ product.url }}"
          class="product-item"
          data-product-id="{{ product.id }}"
          data-variant-id="{{ variant.id }}"
          data-img="{{ product.featured_image | image_url: width: 400 }}"
          data-title="{{ product.title }}"
          data-price="{{ variant.price | money }}"
          data-desc="{{ product.description | strip_html | truncate: 100 }}"
        >
          <div class="product-image-wrapper">
            <img
              src="{{ product.featured_image | image_url: width: 400 }}"
              alt="{{ product.title }}"
              class="product-image"
              loading="lazy"
              width="400"
              height="400"
            >

            <button
              class="add-to-cart"
              data-variant-id="{{ variant.id }}"
              aria-label="Add {{ product.title }} to cart"
            >
              <img
                src="{{ 'add.svg' | asset_url }}"
                alt="Add to Cart"
                width="22"
                height="22"
              >
            </button>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
    
  </div>
</section>

<div class="modal" id="productModal">
  <div class="modal-content">
    <span class="close" onclick="closeModal()">&times;</span>
    <div class="modal-top">
      <img id="modalImg" src="" alt="Product" width="311" height="447">
      <div class="modal-info">
        <h3 id="modalTitle"></h3>
        <p id="modalPrice"></p>
        <p id="modalDesc"></p>
      </div>
    </div>
    <div class="options" id="colorOptions">
      </div>

    <select id="sizeSelect">
      <option>Choose your size</option>
      </select>

    <button class="add-cart" onclick="addToCart()" style="height: 42px">
      <span>ADD TO CART </span>
      <img
        src="{{'arrow white.svg' |asset_url}}"
        alt="Arrow"
        class="arrow-icon"
        width="26"
        height="12"
      >
    </button>
  </div>
</div>

<div id="toast-container"></div>

<style>
  /* Import Jost font */
  @import url('https://fonts.googleapis.com/css2?family=Lustria&display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap');

  :root {
    --font-family: 'Jost', sans-serif;
    --color-white: #f5f5f5;
    --color-yellow: #fff544;
    --color-black: #000;
    --color-background: #fff;
  }

  * {
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  html,
  body {
    width: 100%;
    height: 100%;
    background: var(--color-background);
    scroll-behavior: smooth;
    font-family: var(--font-family);
  }
  
  /* section 2 */
  .custom-grid-section {
    padding: 80px 50px;
    max-width: 1400px;
    margin: 0 auto;
    background: var(--color-background);
  }

  .grid-title {
    font-family: Lustria;
    font-weight: 400;
    font-style: Regular;
    font-size: 36px;
    line-height: 120%;
    letter-spacing: 0px;
    vertical-align: middle;
    margin-bottom: 20px;
  }

  .grid-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 40px;
  }

  .product-item {
    background: var(--color-background);
    border-radius: 0;
    overflow: hidden;
    box-shadow: none;
    border: 1px solid #e0e0e0;
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .product-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  .product-image-wrapper {
    position: relative;
    overflow: hidden;
    background: var(--color-white);
  }

  .product-image {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .add-to-cart {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .product-item:hover .add-to-cart {
    opacity: 1;
    transform: scale(1);
  }

  .add-to-cart img {
    width: 32px; /* adjust to your preferred size */
    height: 32px;
    display: block;
  }

  /* Modal Styles */
  .modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
.close {
  z-index: 1100;
}
  .modal.show {
    display: flex;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .modal-content {
    background: var(--color-background);
    padding: 40px;
    border-radius: 0;
    max-width: 500px;
    width: 90%;
    text-align: center;
    position: relative;
    animation: slideUp 0.3s ease;
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
  }

  @keyframes slideUp {
    from {
      transform: translateY(30px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .modal-content img {
    height: 250px;
    object-fit: cover;
    border-radius: 0;
    margin-bottom: 24px;
  }

  .close {
    position: absolute;
    top: 20px;
    right: 25px;
    font-size: 28px;
    cursor: pointer;
    color: var(--color-black);
    transition: color 0.3s ease;
    line-height: 1;
    font-weight: 300;
  }

  .close:hover {
    color: var(--color-black);
    opacity: 0.7;
  }

  #modalTitle {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--color-black);
    letter-spacing: 0px;
    line-height: 1.1;
  }

  #modalPrice {
    font-size: 24px;
    color: var(--color-black);
    margin-bottom: 20px;
    font-weight: 400;
  }

  #modalDesc {
    color: var(--color-black);
    margin-bottom: 32px;
    line-height: 1.4;
    font-size: 16px;
    font-weight: 400;
  }

  .options {
    margin: 24px 0;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .options button {
    margin: 0;
    padding: 12px 24px;
    border: 2px solid var(--color-black);
    background: var(--color-background);
    cursor: pointer;
    border-radius: 0;
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
    overflow: hidden;
    color: var(--color-black);
  }

  .options button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--color-black);
    transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 0;
  }

  .options button:hover::before,
  .options button.active::before {
    left: 0;
  }

  .options button span {
    position: relative;
    z-index: 1;
  }

  .options button:hover,
  .options button.active {
    color: var(--color-white);
  }

  select {
    width: 100%;
    padding: 16px;
    margin: 20px 0;
    border: 2px solid var(--color-black);
    border-radius: 0;
    font-size: 14px;
    font-weight: 400;
    background: var(--color-background);
    cursor: pointer;
    text-transform: uppercase;
    font-family: var(--font-family);
    color: var(--color-black);
    -webkit-appearance: none;
    -moz-appearance: none;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="black"><path d="M7 10l5 5 5-5H7z"/></svg>');
    background-repeat: no-repeat;
    background-position: right 15px center;
    background-size: 12px;
  }

  select:focus {
    outline: none;
    border-color: var(--color-black);
  }

  /* Button styles matching banner design */
  .add-cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 41px;
    font-weight: 400;
    font-size: 16px;
    text-decoration: none;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border-radius: 0;
    overflow: hidden;
    background: var(--color-black);
    color: var(--color-white);
    width: 100%;
    font-family: var(--font-family);
  }

  .add-cart::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--color-yellow);
    transition: left 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 0;
  }

  .add-cart:hover::before {
    left: 0;
  }

  .add-cart:hover {
    color: var(--color-black);
  }

  .add-cart span {
    position: relative;
    z-index: 1;
    transition: all 0.4s ease;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .custom-grid-section {
      padding: 40px 20px;
    }

    .grid-title {
      font-family: Lustria;
      font-weight: 400;
      font-style: Regular;
      font-size: 24px;
      line-height: 120%;
      letter-spacing: 0px;
      vertical-align: middle;
      margin-bottom: 40px;
    }

    .grid-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .modal-content {
      padding: 30px 20px;
      width: 95%;
    }

    #modalTitle {
      font-size: 24px;
    }

    #modalPrice {
      font-size: 20px;
    }

    .options {
      align-items: center;
      justify-content: center;
    }

    .options button {
      width: auto;
      min-width: 100px;
    }
  }

  @media (max-width: 480px) {
    .custom-grid-section {
      padding: 30px 15px;
    }

    .grid-title {
      font-family: Lustria;
      font-weight: 400;
      font-style: Regular;
      font-size: 24px;
      line-height: 120%;
      letter-spacing: 0px;
      vertical-align: middle;
      margin-bottom: 30px;
    }

    .grid-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .product-image {
      height: 200px;
    }

    .add-to-cart {
      width: 40px;
      height: 40px;
      top: 15px;
      right: 15px;
    }

    .add-to-cart::after {
      font-size: 20px;
    }

    .modal-content {
      padding: 25px 15px;
    }

    .modal-content img {
      height: 200px;
    }

    #modalTitle {
      font-size: 20px;
    }

    #modalPrice {
      font-size: 18px;
    }
    
    .modal-top {
      flex-direction: column;
      text-align: center;
    }
    .modal-top img {
      width: 100%;
    }
    .modal-info {
      text-align: center;
    }
  }
  
  #toast-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1001;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cg-toast {
    background: #333;
    color: white;
    padding: 15px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    transform: translateX(110%);
    transition: transform 0.4s ease-out;
    opacity: 0;
  }
  .cg-toast.show {
    transform: translateX(0);
    opacity: 1;
  }
  .cg-toast-image img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 3px;
  }
  .cg-toast-info {
    display: flex;
    flex-direction: column;
    font-size: 14px;
  }
  .cg-toast-info strong {
    font-size: 16px;
    margin-bottom: 4px;
  }
  .cg-view-cart {
    color: var(--color-yellow);
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
    white-space: nowrap;
  }
</style>

{% schema %}
{
  "name": "Custom Grid Section",
  "settings": [],
  "presets": [
    {
      "name": "Custom Grid Section"
    }
  ]
}
{% endschema %}

{% javascript %}
  let currentProduct = null;
  let currentProductVariants = [];
  let selectedVariantId = null;

  document.addEventListener('DOMContentLoaded', function () {
    // Open modal when clicking product item
    document.querySelectorAll('.product-item').forEach((item) => {
      item.addEventListener('click', (e) => {
        // Prevent modal from opening if the quick-add button is clicked
        if (e.target.closest('.add-to-cart')) {
          e.preventDefault();
          e.stopPropagation();
          addItemDirect(item);
          return;
        }

        e.preventDefault();
        openModal(item);
      });
    });

    // Handle quick add button click
    document.querySelectorAll('.add-to-cart').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        addItemDirect(btn.closest('.product-item'));
      });
    });
  });

  function openModal(item) {
    const productUrl = item.getAttribute('href');

    // Fetch product data from Shopify
    fetch(`${productUrl}.js`)
      .then(response => response.json())
      .then(product => {
        currentProduct = product;
        currentProductVariants = product.variants;

        document.getElementById('modalImg').src = item.dataset.img;
        document.getElementById('modalTitle').innerText = product.title;
        document.getElementById('modalPrice').innerText = new Intl.NumberFormat(
          'en-US', {
            style: 'currency',
            currency: 'USD'
          }
        ).format(product.price / 100);
        document.getElementById('modalDesc').innerText = item.dataset.desc;

        // Populate color and size options
        populateOptions();
        
        document.getElementById('productModal').classList.add('show');
        document.body.style.overflow = 'hidden';
      })
      .catch(error => {
        console.error('Error fetching product data:', error);
        alert('Could not load product details. Please try again.');
      });
  }

  function closeModal() {
    document.getElementById('productModal').classList.remove('show');
    document.body.style.overflow = 'auto';
    currentProduct = null;
    currentProductVariants = [];
    selectedVariantId = null;
    document.getElementById('colorOptions').innerHTML = '';
    document.getElementById('sizeSelect').innerHTML = '<option>Choose your size</option>';
  }

  function populateOptions() {
    const colorOptionsDiv = document.getElementById('colorOptions');
    const sizeSelect = document.getElementById('sizeSelect');
    
    // Clear previous options
    colorOptionsDiv.innerHTML = '';
    sizeSelect.innerHTML = '<option value="">Choose your size</option>';

    if (!currentProduct) return;

    // Get unique option values
    const availableColors = [...new Set(currentProductVariants.map(v => v.option1).filter(Boolean))];
    const availableSizes = [...new Set(currentProductVariants.map(v => v.option2).filter(Boolean))];
    
    // Create color buttons
    availableColors.forEach(color => {
      const button = document.createElement('button');
      button.innerText = color;
      button.dataset.optionValue = color;
      button.onclick = () => selectOption(button, 'color');
      colorOptionsDiv.appendChild(button);
    });
    
    // Create size options
    availableSizes.forEach(size => {
      const option = document.createElement('option');
      option.value = size;
      option.innerText = size;
      sizeSelect.appendChild(option);
    });

    sizeSelect.onchange = updateSelectedVariant;
  }

  function selectOption(btn, type) {
    const parent = btn.parentElement;
    parent.querySelectorAll('button').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    updateSelectedVariant();
  }

  function updateSelectedVariant() {
    const selectedColorBtn = document.querySelector('#colorOptions button.active');
    const selectedSize = document.getElementById('sizeSelect').value;
    
    if (selectedColorBtn && selectedSize) {
      const selectedColor = selectedColorBtn.dataset.optionValue;
      const foundVariant = currentProductVariants.find(variant => {
        const option1Matches = !variant.option1 || variant.option1 === selectedColor;
        const option2Matches = !variant.option2 || variant.option2 === selectedSize;
        return option1Matches && option2Matches;
      });
      
      if (foundVariant) {
        selectedVariantId = foundVariant.id;
        document.getElementById('modalPrice').innerText = new Intl.NumberFormat(
          'en-US', {
            style: 'currency',
            currency: 'USD'
          }
        ).format(foundVariant.price / 100);
      } else {
        selectedVariantId = null;
        document.getElementById('modalPrice').innerText = 'Variant not available';
      }
    } else {
      selectedVariantId = null;
    }
  }

  function addToCart() {
    if (!selectedVariantId) {
      alert('Please select a color and size.');
      return;
    }

    const formData = {
      'items': [{
        'id': selectedVariantId,
        'quantity': 1
      }]
    };
    
    fetch('/cart/add.js', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        },
        body: JSON.stringify(formData)
    })
    .then(response => {
        if (!response.ok) {
            return response.json().then(err => Promise.reject(err));
        }
        return response.json();
    })
    .then(data => {
        console.log('Successfully added to cart:', data);
        showToast(currentProduct, 'Successfully added to cart');
        closeModal();
    })
    .catch(error => {
        console.error('Cart add error:', error);
        showToast(currentProduct, `Error: ${error.message || 'Could not add to cart'}`);
    });
  }

  function addItemDirect(item) {
    const variantId = parseInt(item.dataset.variantId || '0', 10);
    const title = item.dataset.title;
    const img = item.dataset.img;
    const price = item.dataset.price;

    if (!variantId || variantId <= 0) {
      console.error('Invalid variant ID for direct add:', variantId);
      return;
    }

    const formData = {
      'items': [{
        'id': variantId,
        'quantity': 1
      }]
    };
    
    fetch('/cart/add.js', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        },
        body: JSON.stringify(formData)
    })
    .then(response => {
        if (!response.ok) {
            return response.json().then(err => Promise.reject(err));
        }
        return response.json();
    })
    .then(data => {
        console.log('Successfully added to cart:', data);
        const toastItem = {
          title: title,
          image: img,
          price: price,
        };
        showToast(toastItem, 'Successfully added to cart');
    })
    .catch(error => {
        console.error('Cart add error:', error);
        const toastItem = {
          title: title,
          image: img,
          price: price,
        };
        showToast(toastItem, `Error: ${error.message || 'Could not add to cart'}`);
    });
  }

  function showToast(item, message) {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = 'cg-toast';
    toast.innerHTML = `
    <div class="cg-toast-image"><img src="${item.image}" alt="${item.title}" /></div>
    <div class="cg-toast-info">
      <strong>${message}</strong>
      <div>${item.title}</div>
      <div style="opacity:.8; margin-top:4px">${item.price}</div>
    </div>
    <div class="cg-toast-actions"><a href="/cart" class="cg-view-cart">View Cart</a></div>
  `;
    container.appendChild(toast);
    setTimeout(() => toast.classList.add('show'), 10);
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 400);
    }, 4000);
  }
{% endjavascript %}