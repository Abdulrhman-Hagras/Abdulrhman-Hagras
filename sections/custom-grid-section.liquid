  .choose-gift:hover::before {
    left: 0;
  }

  .choose-gift:hover {
    color: var(--color-white);
  }

  .choose-gift .arrow-icon {
    filter: brightness(0);
  }

  .choose-gift:hover .arrow-icon {
    filter: brightness(0) invert(1);
  }

