  }

  /* Choose Gift button (yellow -> black) */
  .choose-gift {
    background: var(--color-yellow);
    color: var(--color-black);
  }

  .choose-gift::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
