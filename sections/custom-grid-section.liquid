<!-- Modal -->
<div class="modal" id="productModal">
  <div class="modal-content">
    <span class="close" onclick="closeModal()">&times;</span>
    <div class="modal-top">
      <img
        id="modalImg"
        src=""
        alt="Product"
        width="311"
        height="447"
      >
      <div class="modal-info">
        <h3 id="modalTitle"></h3>
        <p id="modalPrice"></p>
        <p id="modalDesc"></p>
      </div>
    </div>
    <div class="options">
      <button onclick="selectColor(this)"><span>White</span></button>
      <button onclick="selectColor(this)"><span>Black</span></button>
    </div>

    <select id="sizeSelect">
      <option>Choose your size</option>
      <option>XS</option>
      <option>S</option>
      <option>M</option>
      <option>L</option>
      <option>XL</option>
    </select>

    <button
      class="add-cart"
      onclick="addToCart()"
      style="height: 42px;"
    >
      <span>ADD TO CART </span>
      <img
        src="{{'arrow white.svg' |asset_url}}"
        alt="Arrow"
        class="arrow-icon"
        width="26"
        height="12"
      >
    </button>
  </div>
</div>

<style>
  /* Import Jost font */
  @import url('https://fonts.googleapis.com/css2?family=Lustria&display=swap');
