    background: var(--color-background);
    display: flex;
    flex-direction: column;
  }

  /* Top Header Bar */
  .banner-top-bar {
    height: 64px;
    position: relative;
    z-index: 10;
    display: flex;
    width: 100%;
    justify-content: space-around;
    align-items: center;
    background: var(--color-white);
    padding: 10px 50px;
  }

  .hamburger-menu {
    flex: 0 0 auto;
    display: none; /* Hidden on desktop */
  }
  .banner-main-content .banner-illustration-3 {
    display: none;
  }
  .menu-icon {
    width: 20px;
    height: 13px;
  }

  .brand-logo {
    flex: 0 0 auto;
  }

  .logo-icon {
    width: 153px;
    height: 20px;
  }

  .tagline {
    font-weight: 400;
    font-size: 16px;
    line-height: 13.42px;
    letter-spacing: 0px;
    text-align: center;
    vertical-align: middle;
    color: var(--color-black);
  }

  /* Banner Content Area */
  .banner-content {
    align-items: center;
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Background illustration */
  .banner-illustration {
    text-align: center;
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* Main content container */
  .banner-bottom-row {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-around;
  }

  /* Main Content */
